# Copy this file to .env and fill in the values. Never commit .env to git.

# SQLite works out of the box. For PostgreSQL use e.g.
# postgresql+psycopg://user:password@localhost:5432/smarttaka
# Use Render PostgreSQL in production. SQLite is for local development only.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Long random string used to sign login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# JSON list of browser origins allowed to call this API.
CORS_ORIGINS=["https://smarttaka.onrender.com"]

# "harakapay" = real payments. "mock" = FAKE payments for testing (auto-completes after ~8 seconds).
PAYMENT_PROVIDER=harakapay

HARAKAPAY_API_KEY=hpk_your_key_here
# Secret that must appear in the webhook URL (?token=...). Generate the same way as SECRET_KEY.
HARAKAPAY_WEBHOOK_TOKEN=
# Public HTTPS URL of THIS server's webhook, including the token, e.g.
# https://xxxx.ngrok-free.app/payments/webhooks/harakapay?token=<HARAKAPAY_WEBHOOK_TOKEN>
HARAKAPAY_WEBHOOK_URL=

# Monthly fee per household in TZS (HarakaPay minimum is 200). 200 is for testing only.
MONTHLY_FEE_TZS=200

# ---------------- SMS (Briq) ----------------
# "mock" only prints SMS in the terminal (safe for testing). "briq" sends real SMS and costs credits.
SMS_PROVIDER=
BRIQ_API_KEY=
BRIQ_SENDER_ID=
# Meseji (meseji.co.tz): set SMS_PROVIDER=meseji to use these instead of Briq.
# "MESEJI" works immediately (shared sender ID); request your own via /sms/request-sender-id.
MESEJI_API_KEY=
MESEJI_SENDER_ID=MESEJI
# Link shown inside the billing SMS
APP_URL=https://smarttaka.onrender.com
# ---------------- IoT bin sensors ----------------
# Secret the sensors send in the X-Sensor-Key header. Leave empty to disable the sensor endpoint.
SENSOR_API_KEY=

# ---------------- Route engine ----------------
# Planning uses the public OSRM Table API; no Google Maps key is required.
DEPOT_LATITUDE=-6.838848  # where trucks start and end the day - SET YOUR REAL DEPOT
DEPOT_LONGITUDE=39.271071
FUEL_PRICE_TZS_PER_LITER=3000
